---
import Layout from "../../layouts/Layout.astro";
import pt from "../../i18n/pt";
import NavBar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import BuildTrust from "../../components/BuildTrust.astro";
import About from "../../components/About.astro";
import Stats from "../../components/Stats.astro";
import Work from "../../components/Work.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import Marquee from "../../components/Marquee.astro";
import aduanasLogo from "../../assets/aduana-logo.webp";
import segurosLogo from "../../assets/seguros-logo.webp";
---

<Layout lang="pt" title={pt.meta.title} description={pt.meta.description}>
  <NavBar content={pt.nav} />

  <main class="min-h-screen bg-[#F7F9F9]">
    <Hero content={pt.hero} />

    <Services content={pt.services} />

    <BuildTrust content={pt.build_trust} />

    <About content={pt.about} />

    <Stats content={pt.about.stats} />

    <Work content={pt.process} />

    <Marquee
      content={pt.marquee}
      logos={[
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
      ]}
    />

    <Contact content={pt.contact} />
  </main>

  <Footer content={pt.footer} />
</Layout>
