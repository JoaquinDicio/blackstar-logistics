---
import Layout from "../../layouts/Layout.astro";
import es from "../../i18n/es";
import NavBar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import BuildTrust from "../../components/BuildTrust.astro";
import About from "../../components/About.astro";
import Stats from "../../components/Stats.astro";
import Work from "../../components/Work.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import Marquee from "../../components/Marquee.astro";
import aduanasLogo from "../../assets/aduana-logo.webp";
import segurosLogo from "../../assets/seguros-logo.webp";
---

<Layout lang="en" title={es.meta.title} description={es.meta.description}>
  <NavBar content={es.nav} />
  <main class="bg-[#F7F9F9] min-h-screen">
    <Hero content={es.hero} />

    <Services content={es.services} />

    <BuildTrust content={es.build_trust} />

    <About content={es.about} />

    <Stats content={es.about.stats} />

    <Work content={es.process} />

    <Marquee
      content={es.marquee}
      logos={[
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
        { src: aduanasLogo.src, alt: "Aduanas" },
        { src: segurosLogo.src, alt: "Seguros" },
      ]}
    />

    <Contact content={es.contact} />
  </main>
  <Footer content={es.footer} />
</Layout>
