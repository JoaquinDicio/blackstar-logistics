---
import { Mail, MapPin, Phone, Instagram, MessageCircle } from "lucide-astro";

import contactImage from "../assets/contact_background.png";

interface Props {
  content: {
    eyebrow: string;
    description: string;
    form: {
      name: string;
      lastName: string;
      email: string;
      message: string;
      submit: string;
    };
    contactInfo: {
      title: string;
      phone: string;
      emails: string[];
    };
    offices: {
      title: string;
      locations: string[];
    };
  };
}

const { content } = Astro.props;
---

<section
  id="contact"
  class="relative overflow-hidden sm:px-6 px-5 sm:py-20 py-12 lg:px-8"
>
  <!-- Background -->
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url(${contactImage.src})`}
  >
  </div>

  <!-- Content -->
  <div
    data-aos="fade-up"
    class="relative z-10 mx-auto grid max-w-6xl gap-6 lg:grid-cols-[1.15fr_0.85fr]"
  >
    <!-- Form -->
    <div
      class="rounded-2xl bg-white/90 shadow-lg backdrop-blur-sm md:p-12 py-10 px-10"
    >
      <h2 class="text-lg font-bold uppercase text-(--blue)">
        {content.eyebrow}
      </h2>

      <p class="mt-2 max-w-xl text-sm leading-snug text-gray-600">
        {content.description}
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="mt-6 space-y-3"
      >
        <input
          type="hidden"
          name="access_key"
          value="16ea0a40-cab5-4be8-833e-f1c083de274c"
        />

        <input
          type="hidden"
          name="subject"
          value="New contact request - BlackStar Logistics"
        />

        <input
          type="hidden"
          name="from_name"
          value="BlackStar Logistics Website"
        />

        <input
          type="hidden"
          name="redirect"
          value="https://blackstar-logistics.com/contact"
        />

        <!-- Name + Last name -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <input
            type="text"
            name="name"
            placeholder={content.form.name}
            required
            class="h-11 rounded-md bg-white px-4 text-sm text-gray-800 outline-none placeholder:text-gray-400 focus:ring-2 focus:ring-(--blue)"
          />

          <input
            type="text"
            name="lastName"
            placeholder={content.form.lastName}
            required
            class="h-11 rounded-md bg-white px-4 text-sm text-gray-800 outline-none placeholder:text-gray-400 focus:ring-2 focus:ring-(--blue)"
          />
        </div>

        <!-- Email -->
        <input
          type="email"
          name="email"
          placeholder={content.form.email}
          required
          class="h-11 w-full rounded-md bg-white px-4 text-sm text-gray-800 outline-none placeholder:text-gray-400 focus:ring-2 focus:ring-(--blue)"
        />

        <!-- Message -->
        <textarea
          name="message"
          rows="5"
          placeholder={content.form.message}
          required
          class="w-full resize-none rounded-md bg-white px-4 py-3 text-sm text-gray-800 outline-none placeholder:text-gray-400 focus:ring-2 focus:ring-(--blue)"
        ></textarea>

        <!-- Submit -->
        <button
          type="submit"
          class="h-12 w-full cursor-pointer rounded-md bg-(--blue) text-sm font-medium text-white transition-colors hover:bg-(--blue-dark)"
        >
          {content.form.submit}
        </button>
      </form>
    </div>

    <!-- Right column -->
    <div class="flex flex-col gap-6">
      <!-- Contact -->
      <div
        class="rounded-[20px] bg-white/90 p-10 pb-12 shadow-lg backdrop-blur-sm"
      >
        <h3 class="text-lg font-bold uppercase text-(--blue)">
          {content.contactInfo.title}
        </h3>

        <div class="mt-4 space-y-3 text-sm text-gray-700">
          <a
            href={`tel:${content.contactInfo.phone}`}
            class="flex items-center gap-3 transition-colors hover:text-(--blue)"
          >
            <Phone size={21} strokeWidth={2} class="shrink-0 text-(--blue)" />

            <span>{content.contactInfo.phone}</span>
          </a>

          {
            content.contactInfo.emails.map((email) => (
              <a
                href={`mailto:${email}`}
                class="flex items-center gap-3 transition-colors hover:text-(--blue)"
              >
                <Mail
                  size={21}
                  strokeWidth={2}
                  class="shrink-0 text-(--blue)"
                />

                <span>{email}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Offices -->
      <div
        class="rounded-[20px] bg-white/90 p-10 pb-12 shadow-lg backdrop-blur-sm"
      >
        <h3 class="text-lg font-bold uppercase text-(--blue)">
          {content.offices.title}
        </h3>

        <div class="mt-4 space-y-4 text-sm text-gray-700">
          {
            content.offices.locations.map((location) => (
              <div class="flex items-start gap-3">
                <MapPin
                  size={21}
                  strokeWidth={2}
                  class="mt-0.5 shrink-0 text-(--blue)"
                />

                <span>{location}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-4 px-2">
        <a
          href="#"
          aria-label="WhatsApp"
          class="text-white transition-opacity hover:opacity-70"
        >
          <MessageCircle size={38} strokeWidth={1.8} />
        </a>

        <a
          href="#"
          aria-label="Instagram"
          class="text-white transition-opacity hover:opacity-70"
        >
          <Instagram size={38} strokeWidth={1.8} />
        </a>
      </div>
    </div>
  </div>
</section>
