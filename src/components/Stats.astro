---
import logo from "../assets/logo.png";
import statsBg from "../assets/stats_background.png";

interface Props {
  content: Stat[];
}

type Stat = {
  value: string;
  label: string;
};

const { content }: Props = Astro.props;
---

<section
  class="stats-section flex items-center bg-center bg-no-repeat bg-cover"
  style={`background-image: url(${statsBg.src})`}
>
  <div
    class="mx-auto bg-(--blue)/85 px-6 py-5 w-full h-full min-h-55 flex items-center justify-center"
  >
    <div class="flex items-center max-w-6xl">
      <!-- Logo -->
      <div class="hidden shrink-0 pr-8 lg:block">
        <img src={logo.src} alt="Logo" class="" />
      </div>

      <!-- Stats -->
      <div class="grid w-full grid-cols-2 sm:grid-cols-4">
        {
          content?.map((stat, index) => (
            <div
              class:list={[
                "flex flex-col items-center justify-center px-5 py-3 text-center",
                index !== 0 && "sm:border-l border-white/30",
              ]}
            >
              <span
                class="stat-number text-2xl font-bold leading-none text-white md:text-3xl"
                data-value={stat.value}
              >
                0
              </span>

              <span class="mt-1 max-w-[110px] text-[10px] font-medium leading-tight text-white/90 md:text-xs">
                {stat.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
<script>
  const section = document.querySelector<HTMLElement>(".stats-section");
  const stats = document.querySelectorAll<HTMLElement>(".stat-number");

  const animateNumber = (element: HTMLElement) => {
    const value = element.dataset.value ?? "";
    const target = parseInt(value.replace(/\D/g, ""), 10);
    const prefix = value.match(/^\D+/)?.[0] ?? "";

    if (isNaN(target)) return;

    const duration = 1500;
    const start = performance.now();

    const update = (currentTime: number) => {
      const progress = Math.min((currentTime - start) / duration, 1);
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(target * easedProgress);

      element.textContent = `${prefix}${current}`;

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    };

    requestAnimationFrame(update);
  };

  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          stats.forEach(animateNumber);
          observer.unobserve(section);
        }
      },
      { threshold: 0.2 },
    );

    observer.observe(section);
  }
</script>
