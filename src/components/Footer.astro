---
import { Mail, Instagram, MessageCircle } from "lucide-astro";

import logo from "../assets/logo.png";

interface Props {
  content: {
    copyright: string;
  };
}

const { content } = Astro.props;
---

<footer class="bg-(--blue) px-6 py-8 lg:px-8">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 md:flex-row"
  >
    <!-- Logo -->
    <a href="/" aria-label="Blackstar Logistics">
      <img
        src={logo.src}
        alt="Blackstar Logistics"
        class="h-20 w-auto object-contain"
      />
    </a>

    <!-- Copyright -->
    <p class="text-center text-xs text-white/70">
      {content.copyright}
    </p>

    <!-- Social -->
    <div class="flex items-center gap-5">
      <a
        target="_blank"
        href="mailto:pabloy@bstarlog.com"
        aria-label="Email"
        class="text-white transition-opacity hover:opacity-70"
      >
        <Mail size={32} strokeWidth={1.8} />
      </a>

      <a
        href="https://wa.me/5492995857930"
        target="_blank"
        aria-label="WhatsApp"
        class="text-white transition-opacity hover:opacity-70"
      >
        <MessageCircle size={32} strokeWidth={1.8} />
      </a>

      <a
        target="_blank"
        href="https://www.instagram.com/black_starlogistics_arg/"
        aria-label="Instagram"
        class="text-white transition-opacity hover:opacity-70"
      >
        <Instagram size={32} strokeWidth={1.8} />
      </a>
    </div>
  </div>
</footer>
