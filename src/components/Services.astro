---
const {content} = Astro.props
import Title from "./Title.astro";

interface Service {
    image:string,
    title: string;
    description: string;
}

---

<section class="min-h-screen px-20 text-[--text-dark] flex flex-col items-center">
    <Title title={content.title} />

    <p class="text-[14px] mt-8 mb-10  max-w-130 font-medium text-center">
        {content.description}
    </p>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 max-w-250">
        {content.items.map((item : Service) => (
            <div class="text-white rounded-[20px] overflow-hidden bg-cover bg-no-repeat min-h-62.5" style={`background-image: url(${item.image})`}>
                <div class="bg-[#02326D]/80 p-8 h-full">
                    <h3 class="font-bold text-[16px] pb-5">{item.title}</h3>
                    <p class="font-medium text-[14px]">{item.description}</p>
                </div>
            </div>
        ))}     
    </div>
</section>