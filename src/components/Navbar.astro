---
import { Menu, X, ChevronDown } from "lucide-astro";
import logo from "../assets/logo.png";

interface Props {
  content: {
    about: string;
    services: string;
    work: string;
    contact: string;
    quote: string;
    language: string;
    language_switch: string;
  };
}

const { content } = Astro.props;

const pathname = Astro.url.pathname;

const isSpanish = pathname.startsWith("/es");
const isPortuguese = pathname.startsWith("/pt");

const currentLanguage = isSpanish ? "es" : isPortuguese ? "pt" : "en";

const languages = [
  {
    code: "es",
    label: "ES",
    name: "Español",
    flag: "https://flagicons.lipis.dev/flags/4x3/ar.svg",
    href: "/es",
  },
  {
    code: "en",
    label: "EN",
    name: "English",
    flag: "https://flagicons.lipis.dev/flags/4x3/gb.svg",
    href: "/",
  },
  {
    code: "pt",
    label: "PT",
    name: "Português",
    flag: "https://flagicons.lipis.dev/flags/4x3/br.svg",
    href: "/pt",
  },
];

const currentLanguageData = languages.find(
  (language) => language.code === currentLanguage,
)!;
---

<nav class="absolute top-0 left-0 z-100 w-full pt-5 md:pt-8">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-2 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <a
      href={currentLanguageData.href}
      aria-label="Blackstar Logistics"
      class="shrink-0"
    >
      <img src={logo.src} alt="Blackstar Logistics" class="w-60 lg:w-80" />
    </a>

    <!-- Desktop navigation -->
    <div
      class="hidden items-center gap-6 rounded-full bg-white/80 px-8 py-4 font-medium text-(--blue) backdrop-blur-sm md:flex lg:gap-8 lg:px-10"
    >
      <a href="#about" class="text-sm font-medium whitespace-nowrap">
        {content.about}
      </a>

      <a href="#services" class="text-sm font-medium whitespace-nowrap">
        {content.services}
      </a>

      <a href="#work" class="text-sm font-medium whitespace-nowrap">
        {content.work}
      </a>

      <a href="#contact" class="text-sm font-medium whitespace-nowrap">
        {content.contact}
      </a>
    </div>

    <!-- Desktop language selector -->
    <div class="relative hidden lg:block">
      <button
        id="language-button"
        type="button"
        aria-expanded="false"
        aria-controls="language-menu"
        class="flex items-center gap-2 rounded-full bg-white/80 px-3 py-2 text-sm font-semibold text-(--blue) backdrop-blur-sm transition-colors hover:bg-white"
      >
        <img
          src={currentLanguageData.flag}
          alt={currentLanguageData.name}
          class="h-5 w-7 rounded-sm object-cover"
        />

        <span>{currentLanguageData.label}</span>

        <ChevronDown
          size={15}
          strokeWidth={2}
          class="language-chevron transition-transform duration-200"
        />
      </button>

      <!-- Language options -->
      <div
        id="language-menu"
        class="language-menu absolute right-0 top-full mt-2 min-w-36 rounded-xl bg-white p-1.5 shadow-lg"
        aria-hidden="true"
      >
        {
          languages.map((language) => (
            <a
              href={language.href}
              class:list={[
                "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-(--blue)",
                "transition-colors hover:bg-gray-100",
                {
                  "bg-gray-100": language.code === currentLanguage,
                },
              ]}
            >
              <img
                src={language.flag}
                alt={language.name}
                class="h-5 w-7 rounded-sm object-cover"
              />

              <span class="flex-1">{language.name}</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Desktop quote -->
    <a
      href="#contact"
      class="hidden shrink-0 rounded-full bg-(--blue) px-7 py-3.5 text-sm font-medium text-white transition-colors hover:bg-(--blue-dark) lg:px-10 lg:py-4 xl:block"
    >
      {content.quote}
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-(--blue) text-white md:hidden"
    >
      <Menu
        size={25}
        strokeWidth={1.8}
        class="menu-icon transition-transform duration-300"
      />

      <X
        size={25}
        strokeWidth={1.8}
        class="close-icon hidden transition-transform duration-300"
      />
    </button>
  </div>

  <!-- Mobile navigation -->
  <div
    id="mobile-menu"
    aria-hidden="true"
    class="mobile-menu absolute top-full left-2 right-2 mt-3 rounded-2xl bg-white/95 p-6 shadow-lg backdrop-blur-sm md:hidden"
  >
    <div class="flex flex-col gap-5 text-(--blue)">
      <a href="#about" class="font-medium">
        {content.about}
      </a>

      <a href="#services" class="font-medium">
        {content.services}
      </a>

      <a href="#work" class="font-medium">
        {content.work}
      </a>

      <a href="#contact" class="font-medium">
        {content.contact}
      </a>

      <!-- Mobile language selector -->
      <div class="border-t border-gray-200 pt-4">
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500"
        >
          {content.language_switch}
        </p>

        <div class="flex flex-col gap-2">
          {
            languages.map((language) => (
              <a
                href={language.href}
                class:list={[
                  "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium",
                  "transition-colors",
                  {
                    "bg-gray-100 text-(--blue)":
                      language.code === currentLanguage,
                    "text-(--blue) hover:bg-gray-100":
                      language.code !== currentLanguage,
                  },
                ]}
              >
                <img
                  src={language.flag}
                  alt={language.name}
                  class="h-5 w-7 rounded-sm object-cover"
                />

                <span class="flex-1">{language.name}</span>

                <span class="text-xs font-semibold text-gray-400">
                  {language.label}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Mobile quote -->
      <a
        href="#contact"
        class="mt-1 w-full rounded-full bg-(--blue) px-5 py-3 text-center text-sm font-medium text-white transition-colors hover:bg-(--blue-dark)"
      >
        {content.quote}
      </a>
    </div>
  </div>
</nav>

<style>
  .language-menu {
    opacity: 0;
    transform: translateY(-5px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  .language-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu {
    opacity: 0;
    transform: translateY(-10px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 250ms ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const menuIcon = menuButton?.querySelector(".menu-icon");
  const closeIcon = menuButton?.querySelector(".close-icon");

  const languageButton =
    document.querySelector<HTMLButtonElement>("#language-button");

  const languageMenu = document.querySelector<HTMLElement>("#language-menu");

  const languageChevron = languageButton?.querySelector(".language-chevron");

  if (languageButton && languageMenu) {
    const setLanguageState = (open: boolean) => {
      languageMenu.classList.toggle("is-open", open);

      languageButton.setAttribute("aria-expanded", String(open));

      languageMenu.setAttribute("aria-hidden", String(!open));

      languageChevron?.classList.toggle("rotate-180", open);
    };

    languageButton.addEventListener("click", (event) => {
      event.stopPropagation();

      const isOpen = languageButton.getAttribute("aria-expanded") === "true";

      setLanguageState(!isOpen);
    });

    document.addEventListener("click", () => {
      setLanguageState(false);
    });

    languageMenu.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setLanguageState(false);
      }
    });
  }

  if (menuButton && mobileMenu) {
    const setMenuState = (open: boolean) => {
      mobileMenu.classList.toggle("is-open", open);

      menuButton.setAttribute("aria-expanded", String(open));

      menuButton.setAttribute(
        "aria-label",
        open ? "Cerrar menú" : "Abrir menú",
      );

      mobileMenu.setAttribute("aria-hidden", String(!open));

      menuIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";

      setMenuState(!isOpen);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuState(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuState(false);
      }
    });
  }
</script>
