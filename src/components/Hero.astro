---
import { Mail, PackageCheck } from "lucide-astro";
import heroBg from "../assets/hero-bg.png";
import RoundedButton from "../components/RoundedButton.astro";

interface Props {
  content: {
    description: string;
    contact: string;
    services: string;
  };
}

const { content } = Astro.props;
---

<section
  class="relative overflow-hidden bg-top-center bg-no-repeat bg-cover bg-fixed"
  style={`background-image: url(${heroBg.src})`}
>
  <!-- Hero content -->
  <div
    class="relative min-h-screen bg-black/60 z-10 flex h-full flex-col items-center justify-center px-6 pb-10 text-center"
  >
    <h1
      class="text-4xl uppercase font-black tracking-tight text-white sm:text-4xl md:text-5xl"
    >
      BlackStar Logistics
    </h1>

    <p
      class="mt-3 max-w-2xl font-medium leading-relaxed text-white/90 sm:text-sm"
    >
      {content.description}
    </p>

    <div class="mt-5 flex items-center gap-3">
      <RoundedButton href="#contact" text={content.services}>
        <Mail size={16} />
        Contactar
      </RoundedButton>
      <RoundedButton className="bg-white text-(--blue)! hover:bg-slate-100" href="#services" text={content.services}>
        <PackageCheck size={16} />
        Nuestros servicios
      </RoundedButton>
    </div>
  </div>

  <div
    class="absolute bottom-[-15%] left-1/2 z-20 h-[25%] w-[120%] -translate-x-1/2 rounded-[50%_50%_0_0] bg-[#F7F9F9]"
  >
  </div>
</section>
